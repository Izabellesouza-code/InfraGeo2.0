# Aplicação
APP_NAME=InfraGeo AM
APP_VERSION=2.0.0
DEBUG=true
SECRET_KEY=altere-esta-chave-em-producao

# Servidor (Render define PORT automaticamente)
HOST=0.0.0.0
PORT=8000

# Banco — Supabase (PostGIS)
# Dashboard → Connect → Session pooler (IPv4) OU Direct (IPv6)
# Troque [SENHA] e o host pelos valores do seu projeto.
# Senha com @ / # / % deve ser URL-encoded (%40, %23, %25).
#
# Session pooler (recomendado no Render / redes só IPv4):
# DATABASE_URL=postgresql+psycopg2://postgres.SEU_REF:SENHA@aws-0-SA_REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
#
# Direct:
# DATABASE_URL=postgresql+psycopg2://postgres:SENHA@db.SEU_REF.supabase.co:5432/postgres?sslmode=require
#
# Local Docker:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/infrageo
DATABASE_URL=postgresql+psycopg2://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# GIS — centro no Amazonas
DEFAULT_CRS=EPSG:4326
DEFAULT_MAP_CENTER_LAT=-3.4653
DEFAULT_MAP_CENTER_LON=-62.2159
DEFAULT_MAP_ZOOM=5

POSTGIS_SIMPLIFY_TOLERANCE=0.00035
POSTGIS_GEOJSON_LIMIT=0

# Uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports

# Auth bootstrap (troque em produção)
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=InfraGeo@2026
AUTH_BOOTSTRAP_EMAIL=admin@infrageo.local

# CORS — inclua a URL da Vercel (ex.: https://infrageo2.vercel.app)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app$
