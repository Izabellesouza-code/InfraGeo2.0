# Aplicação
APP_NAME=InfraGeo AM
APP_VERSION=2.0.0
DEBUG=true
SECRET_KEY=altere-esta-chave-em-producao

# Servidor (Render define PORT automaticamente)
HOST=0.0.0.0
PORT=8000

# Banco PostGIS
# Local Docker: postgresql+psycopg2://postgres:SENHA@localhost:5432/infrageo
# Servidor na rede: use IPv4 (evita bloqueio IPv6 no pg_hba)
# Senha com @ → %40 (ex.: Minha@Senha → Minha%40Senha)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Sync schemas: origem local → Neon (nuvem)
# SOURCE = onde você cria schemas (Postgres local/rede)
# NEON   = banco em nuvem usado pelo site (se vazio, usa DATABASE_URL)
# SOURCE_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/infrageo
# NEON_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require
SCHEMA_SYNC_AUTO_GIT=false
SCHEMA_SYNC_GIT_REMOTE=origin
SCHEMA_SYNC_GIT_BRANCH=main
# Schemas que nunca podem ser apagados (além de public/topology)
SCHEMA_SYNC_PROTECTED=public,topology,tiger,tiger_data,LIMITE_ESTADUAL,LIMITE_MUNICIPAL
SCHEMA_SYNC_DELETE_PHRASE_PREFIX=EXCLUIR

# GIS — centro no Amazonas
DEFAULT_CRS=EPSG:4326
DEFAULT_MAP_CENTER_LAT=-3.4653
DEFAULT_MAP_CENTER_LON=-62.2159
DEFAULT_MAP_ZOOM=5

POSTGIS_SIMPLIFY_TOLERANCE=0
POSTGIS_GEOJSON_LIMIT=0

# Uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports

# Auth bootstrap (obrigatório no .env — sem senha no código)
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=altere-esta-senha
AUTH_BOOTSTRAP_EMAIL=admin@infrageo.local

# CORS — inclua a URL da Vercel (ex.: https://infrageo2.vercel.app)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app$

# Front na Vercel (produção no Render: DEBUG=false + esta URL → / redireciona)
# FRONTEND_URL=https://seu-app.vercel.app

# Só no build da Vercel (já vem no vercel.json):
# INFRA_GEO_API_URL=https://infrageo2-0.onrender.com
