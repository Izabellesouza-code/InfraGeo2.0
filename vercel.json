{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "uv pip install --system -r requirements-frontend.txt",
  "buildCommand": "python scripts/build_frontend.py",
  "outputDirectory": "frontend/dist",
  "env": {
    "INFRA_GEO_API_URL": "https://infrageo2-0.onrender.com",
    "APP_NAME": "InfraGeo AM"
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!static/).*)", "destination": "/index.html" }
  ]
}
