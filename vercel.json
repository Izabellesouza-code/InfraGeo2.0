{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "echo \"deps no build\"",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "frontend/dist",
  "env": {
    "INFRA_GEO_API_URL": "https://infrageo2-0.onrender.com",
    "APP_NAME": "InfraGeo AM"
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=120, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/definir-senha", "destination": "/definir-senha.html" },
    { "source": "/esqueci-senha", "destination": "/esqueci-senha.html" },
    { "source": "/redefinir-senha", "destination": "/redefinir-senha.html" },
    { "source": "/((?!static/).*)", "destination": "/index.html" }
  ]
}
